{
  "info": {
    "name": "AI Voice Orchestration System",
    "description": "API endpoints for the AI Voice Orchestration System with Django REST and FastAPI",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Obtain JWT Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"your_username\",\n  \"password\": \"your_password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/token/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "token",
                ""
              ]
            },
            "description": "Get JWT access and refresh tokens for authentication"
          },
          "response": []
        },
        {
          "name": "Refresh JWT Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"your_refresh_token_here\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/token/refresh/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "token",
                "refresh",
                ""
              ]
            },
            "description": "Refresh expired JWT access token using refresh token"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Agents Management",
      "item": [
        {
          "name": "Get All Agents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "disabled": false
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/agents/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "agents",
                ""
              ]
            },
            "description": "Retrieve list of all agents (public read access)"
          },
          "response": []
        },
        {
          "name": "Get Agent by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/agents/1/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "agents",
                "1",
                ""
              ]
            },
            "description": "Retrieve a specific agent by ID (public read access)"
          },
          "response": []
        },
        {
          "name": "Create Agent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Medical Assistant\",\n  \"category\": \"medical\",\n  \"system_prompt\": \"You are a medical guidance AI. Provide general health information, precautions, and explanations. Do NOT provide diagnoses or prescriptions. Always include disclaimers.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/agents/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "agents",
                ""
              ]
            },
            "description": "Create a new agent (authenticated users only)"
          },
          "response": []
        },
        {
          "name": "Update Agent",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Advanced Medical Assistant\",\n  \"category\": \"medical\",\n  \"system_prompt\": \"You are an advanced medical guidance AI. Provide comprehensive health information with detailed precautions and explanations. Always include medical disclaimers.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/agents/1/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "agents",
                "1",
                ""
              ]
            },
            "description": "Update an existing agent (authenticated users only, owner)"
          },
          "response": []
        },
        {
          "name": "Partial Update Agent",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Medical Assistant v2\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/agents/1/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "agents",
                "1",
                ""
              ]
            },
            "description": "Partially update an agent (authenticated users only, owner)"
          },
          "response": []
        },
        {
          "name": "Delete Agent",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/agents/1/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "agents",
                "1",
                ""
              ]
            },
            "description": "Delete an agent (authenticated users only, owner)"
          },
          "response": []
        }
      ]
    },
