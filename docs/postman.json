    {
      "name": "WebSocket Chat (FastAPI Streaming)",
      "item": [
        {
          "name": "Connect to Agent Chat",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "ws://{{ws_base_url}}/ws/chat/1",
              "protocol": "ws",
              "host": [
                "{{ws_base_url}}"
              ],
              "path": [
                "ws",
                "chat",
                "1"
              ]
            },
            "description": "WebSocket connection to chat with agent (replace 1 with agent_id). Use this in Postman's WebSocket feature or any WebSocket client. Send text messages to interact with the agent."
          },
          "response": []
        }
      ]
