  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string",
      "description": "Django REST API base URL"
    },
    {
      "key": "ws_base_url",
      "value": "127.0.0.1:8000",
      "type": "string",
      "description": "FastAPI WebSocket server base URL"
    },
    {
      "key": "access_token",
      "value": "your_jwt_access_token_here",
      "type": "string",
      "description": "JWT access token obtained from /api/token/ endpoint"
    }
  ]
